# owner/name of the party repo Sir Nitpicksalot reviews and merges into.
TARGET_REPO=
# Fine-grained PAT scoped to TARGET_REPO only: Contents, Issues, Pull requests = Read & write.
# Never grant Workflows. The knight comments and merges as the owner of this token.
KNIGHT_GITHUB_TOKEN=
# Random string (openssl rand -hex 32). Keeps reviews unpredictable. Don't change it mid-event.
KNIGHT_SECRET=
# Secret configured on the target repo's webhook.
GITHUB_WEBHOOK_SECRET=

# Optional
BASE_BRANCH=main
STRICTNESS=proper             # lenient | proper | insufferable
MAX_REVIEW_ROUNDS=            # default depends on the strictness
MIN_CHANGED_LINES=6
MERGE_COOLDOWN_MINUTES=4
COPY_TRAP=on                  # invisible characters in demands, so pasted text gets caught
AI_PRANK=off                  # hidden "talk in baby talk" note for AI assistants. Tell participants if on.
EVENT_START=                  # ISO 8601; PRs are held before it
EVENT_MINUTES=80              # …and never merged after start + this
